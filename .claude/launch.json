{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "server",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set PORT=8090&& npm --prefix server run dev"
      ],
      "port": 8090
    }
  ]
}
