{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "zombie-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "cwd": "client"
    },
    {
      "name": "zombie-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8080,
      "cwd": "server"
    },
    {
      "name": "static-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort",
        "--base",
        "/Corvicks-Covid-Contingency/"
      ],
      "port": 4173,
      "cwd": "client",
      "url": "http://localhost:4173"
    }
  ]
}
